# Recopier en .deploy.env (jamais versionné) et y taper le jeton d'API de Coolify.
# Jeton créé dans Coolify : Keys & Tokens > API tokens, permissions « read » + « deploy » SEULEMENT
# (« root » ou « read:sensitive » pourraient lire le jeton Discord rangé dans Coolify).
COOLIFY_TOKEN=
# Le serveur Coolify sur le réseau local
COOLIFY_URL=http://192.168.5.213:8000
# Facultatif : l'uuid de l'appli (dans l'adresse de sa page Coolify) ; sinon cherchée par le dépôt
COOLIFY_APP_UUID=
