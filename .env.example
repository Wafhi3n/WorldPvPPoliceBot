# Recopier ce fichier en .env (jamais versionné) et y taper le jeton du bot.
# Copy this file to .env (never committed) and put your bot token in it.
# Ne jamais coller le jeton dans une conversation, un ticket ou un commit.
DISCORD_TOKEN=
# Le salon Discord relié à la guilde dans le jeu (le bot le LIT et y efface les lignes traitées)
# The Discord channel linked to the in-game guild (the bot READS it and deletes handled lines)
DISCORD_CHANNEL_ID=
# Le salon des cartes d'appel, #alertes-pvp (vide = aucune carte)
# The channel for call cards, #alertes-pvp (empty = no cards)
DISCORD_PVP_CHANNEL_ID=
# Le rôle mentionné à un NOUVEL appel (vide = aucune mention) ; jamais @everyone
# The role pinged on a NEW call (empty = no ping); never @everyone
DISCORD_PVP_ROLE_ID=
# journal = note ce qui passe sans rien faire (1er lancement) ; repondre = fait les cartes
# journal = logs what passes, does nothing (first run); repondre = makes the cards
BOT_MODE=journal
# oui = la ligne brute quitte le salon relié une fois la carte faite (droit « Gérer les messages »)
# oui = the raw line leaves the linked channel once its card is made (needs "Manage Messages")
BOT_SUPPRIMER=oui
