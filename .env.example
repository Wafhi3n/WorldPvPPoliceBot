# Recopier ce fichier en .env (jamais versionné) et y taper le jeton du bot. Le jeton suffit : le bot
# reconnaît le salon relié à ses messages du jeu, et crée #alertes-pvp et le rôle pvp-police s'ils manquent.
# Copy this file to .env (never committed) and put your bot token in it. The token is enough: the bot
# finds the linked channel by its in-game messages, and creates #alertes-pvp and the pvp-police role.
# Ne jamais coller le jeton dans une conversation, un ticket ou un commit.
DISCORD_TOKEN=

# --- Facultatif / optional ---
# Noms du salon des cartes et du rôle à mentionner (trouvés, ou créés s'ils manquent)
# Names of the cards channel and of the role to ping (found, or created if missing)
DISCORD_PVP_CHANNEL_NAME=alertes-pvp
DISCORD_PVP_ROLE_NAME=pvp-police
# non = ne jamais créer de salon ni de rôle / never create a channel or a role
BOT_INSTALLER=oui
# Identifiants imposés (prioritaires sur les noms ; DISCORD_PVP_CHANNEL_ID = un seul serveur)
# Forced ids (they win over the names; DISCORD_PVP_CHANNEL_ID = a single server)
DISCORD_CHANNEL_ID=
DISCORD_PVP_CHANNEL_ID=
DISCORD_PVP_ROLE_ID=
# journal = note les messages du jeu sans rien faire (1er lancement) ; repondre = fait les cartes
# journal = logs in-game messages, does nothing (first run); repondre = makes the cards
BOT_MODE=journal
# oui = la ligne brute quitte le salon relié une fois la carte faite (droit « Gérer les messages »)
# oui = the raw line leaves the linked channel once its card is made (needs "Manage Messages")
BOT_SUPPRIMER=oui
