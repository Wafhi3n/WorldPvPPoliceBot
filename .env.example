# Recopier ce fichier en .env (jamais versionné) et y taper le jeton du bot, sans guillemets. Le jeton
# suffit : le bot reconnaît le salon relié à ses messages du jeu. Au 1er lancement (BOT_MODE=journal), il
# ne fait que noter ce qu'il voit ; en BOT_MODE=repondre, il crée #alertes-pvp et le rôle pvp-police s'ils
# manquent, puis fait les cartes. Guide : docs/hebergement.md.
# Copy this file to .env (never committed) and put your bot token in it, without quotes. The token is
# enough: the bot finds the linked channel by its in-game messages. On the first run (BOT_MODE=journal) it
# only logs what it sees; with BOT_MODE=repondre it creates #alertes-pvp and the pvp-police role if they
# are missing, then makes the cards. Guide: docs/hosting.md.
# Ne jamais coller le jeton dans une conversation, un ticket ou un commit.
# Never paste the token in a chat, an issue or a commit.
DISCORD_TOKEN=

# --- Facultatif / optional ---
# Langue des cartes : fr ou en (le journal reste en français)
# Language of the cards: fr or en (the log stays in French)
BOT_LANGUE=fr
# Noms du salon des cartes et du rôle à mentionner (trouvés, ou créés s'ils manquent)
# Names of the cards channel and of the role to ping (found, or created if missing)
DISCORD_PVP_CHANNEL_NAME=alertes-pvp
DISCORD_PVP_ROLE_NAME=pvp-police
# non = ne jamais créer de salon ni de rôle / never create a channel or a role
BOT_INSTALLER=oui
# Identifiants imposés (prioritaires sur les noms ; DISCORD_PVP_CHANNEL_ID = un seul serveur)
# Forced ids (they win over the names; DISCORD_PVP_CHANNEL_ID = a single server)
DISCORD_CHANNEL_ID=
DISCORD_PVP_CHANNEL_ID=
DISCORD_PVP_ROLE_ID=
# Une carte finie (réglée ou sans nouvelles) est effacée du salon après ces heures (0 = jamais)
# A finished card (settled or no news) is deleted from the channel after these hours (0 = never)
BOT_GARDER_HEURES=24
# Image de la zone sur les cartes, téléchargée à la demande sur wago.tools (non = sans image)
# Zone map image on the cards, fetched on demand from wago.tools (non = no image)
BOT_CARTES=oui
# wowf = WoW: Forever ; wowt = PTR de Retail / Retail PTR ; wow = Retail
BOT_CARTES_PRODUIT=wowf
# Langue des noms sur l'image (vide = celle des cartes : frFR ou enUS) ; autres : deDE, esES…
# Language of the names on the image (empty = the cards' one: frFR or enUS); others: deDE, esES…
BOT_CARTES_LANGUE=
# journal = note les messages du jeu sans rien faire (1er lancement) ; repondre = fait les cartes
# journal = logs in-game messages, does nothing (first run); repondre = makes the cards
BOT_MODE=journal
# oui = la ligne brute quitte le salon relié une fois la carte faite (droit « Gérer les messages »)
# oui = the raw line leaves the linked channel once its card is made (needs "Manage Messages")
BOT_SUPPRIMER=oui
